# Build context: mono-repo root (not osac-operator/ alone).
# Invoke with: podman build -f osac-operator/Containerfile .
FROM registry.access.redhat.com/ubi10/go-toolset:1.26.7-1791275880 AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /opt/app-root/src
# go.work.sum is intentionally not copied in -- it's not committed to the
# repo (see root .gitignore); `go mod download` below regenerates it inside
# the build using the go.sum files already copied in per module.
COPY --chown=1001:1001 go.work ./
COPY --chown=1001:1001 proto/go.mod proto/go.sum proto/
COPY --chown=1001:1001 osac-operator/go.mod osac-operator/go.sum osac-operator/
COPY --chown=1001:1001 osac-operator/api/go.mod osac-operator/api/go.sum osac-operator/api/
COPY --chown=1001:1001 bare-metal-fulfillment-operator/go.mod bare-metal-fulfillment-operator/go.sum bare-metal-fulfillment-operator/
COPY --chown=1001:1001 fulfillment-service/go.mod fulfillment-service/go.sum fulfillment-service/
COPY --chown=1001:1001 osac-csi-driver/go.mod osac-csi-driver/go.sum osac-csi-driver/
COPY --chown=1001:1001 osac-metering/schema/go.mod osac-metering/schema/go.sum osac-metering/schema/
COPY --chown=1001:1001 osac-metering/metering-service/go.mod osac-metering/metering-service/go.sum osac-metering/metering-service/
COPY --chown=1001:1001 osac-metering/adapters/go.mod osac-metering/adapters/go.sum osac-metering/adapters/
COPY --chown=1001:1001 osac-ui/proxy/go.mod osac-ui/proxy/go.sum osac-ui/proxy/
# Source Hermeto/Cachi2's generated env (GOPROXY/GOFLAGS pointed at the
# prefetched module cache) when present -- i.e. a hermetic Konflux build.
# Absent entirely for local/non-hermetic builds (plain `podman build`, the
# PR/push pipelines before this is rolled out to them), where go mod
# download falls back to the real network as before.
# Share module downloads and checksum database state across component builds.
RUN --mount=type=cache,id=osac-go-pkg,target=/opt/app-root/src/go/pkg,uid=1001,gid=0 \
    cd osac-operator && { [ -f /cachi2/cachi2.env ] && . /cachi2/cachi2.env; GODEBUG=http2client=0 go mod download; }

COPY --chown=1001:1001 proto/ proto/
COPY --chown=1001:1001 osac-operator/ osac-operator/
COPY --chown=1001:1001 bare-metal-fulfillment-operator/ bare-metal-fulfillment-operator/

WORKDIR /opt/app-root/src/osac-operator
RUN --mount=type=cache,id=osac-go-pkg,target=/opt/app-root/src/go/pkg,uid=1001,gid=0 \
    --mount=type=cache,id=osac-go-build,target=/opt/app-root/src/.cache/go-build,uid=1001,gid=0 \
    [ -f /cachi2/cachi2.env ] && . /cachi2/cachi2.env; CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -o manager ./cmd
RUN --mount=type=cache,id=osac-go-pkg,target=/opt/app-root/src/go/pkg,uid=1001,gid=0 \
    --mount=type=cache,id=osac-go-build,target=/opt/app-root/src/.cache/go-build,uid=1001,gid=0 \
    [ -f /cachi2/cachi2.env ] && . /cachi2/cachi2.env; CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -o console-proxy cmd/console-proxy/main.go
RUN --mount=type=cache,id=osac-go-pkg,target=/opt/app-root/src/go/pkg,uid=1001,gid=0 \
    --mount=type=cache,id=osac-go-build,target=/opt/app-root/src/.cache/go-build,uid=1001,gid=0 \
    [ -f /cachi2/cachi2.env ] && . /cachi2/cachi2.env; CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -o trust-admission cmd/trust-admission/main.go

FROM registry.access.redhat.com/ubi10-minimal:1792742518
# Stamped to the real release version on osac-build-and-publish.yaml's
# temp branch before tagging (same mechanism as Chart.yaml's own
# version field) -- the committed default below is only ever what a
# local/dev build sees. Surfaced as a real OCI label so Konflux's
# release-side {{ oci_version }} tag templating resolves to it instead
# of silently falling back to the base image's own inherited version
# label.
ARG VERSION=dev
LABEL name="cloud-extensions/osac-operator-rhel10"
LABEL cpe="cpe:/a:redhat:cloud_extensions:0.1::el10"
LABEL org.opencontainers.image.version="${VERSION}"
COPY --from=builder /opt/app-root/src/osac-operator/manager /usr/local/bin/
COPY --from=builder /opt/app-root/src/osac-operator/console-proxy /usr/local/bin/
COPY --from=builder /opt/app-root/src/osac-operator/trust-admission /usr/local/bin/
USER 1001
ENTRYPOINT ["/usr/local/bin/manager"]
