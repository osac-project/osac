FROM registry.access.redhat.com/ubi10/go-toolset:1.26.10-1793622842 AS builder
ARG TARGETOS
ARG TARGETARCH

# Build context is the repo root so go.work and every workspace module's
# go.mod resolve the same way the hermetic prefetch resolves them.
WORKDIR /opt/app-root/src
COPY --chown=1001:0 go.work ./
COPY --chown=1001:0 proto/go.mod proto/go.sum proto/
COPY --chown=1001:0 osac-operator/go.mod osac-operator/go.sum osac-operator/
COPY --chown=1001:0 osac-operator/api/go.mod osac-operator/api/go.sum osac-operator/api/
COPY --chown=1001:0 bare-metal-fulfillment-operator/go.mod bare-metal-fulfillment-operator/go.sum bare-metal-fulfillment-operator/
COPY --chown=1001:0 fulfillment-service/go.mod fulfillment-service/go.sum fulfillment-service/
COPY --chown=1001:0 osac-csi-driver/go.mod osac-csi-driver/go.sum osac-csi-driver/
COPY --chown=1001:0 osac-metering/adapters/go.mod osac-metering/adapters/go.sum osac-metering/adapters/
COPY --chown=1001:0 osac-metering/metering-service/go.mod osac-metering/metering-service/go.sum osac-metering/metering-service/
COPY --chown=1001:0 osac-metering/schema/go.mod osac-metering/schema/go.sum osac-metering/schema/
COPY --chown=1001:0 osac-ui/proxy/go.mod osac-ui/proxy/go.sum osac-ui/proxy/
COPY --chown=1001:0 osac-observability/go.mod osac-observability/go.sum osac-observability/
RUN --mount=type=cache,id=osac-go-pkg,target=/opt/app-root/src/go/pkg,uid=1001,gid=0 \
    cd osac-observability && { [ -f /cachi2/cachi2.env ] && . /cachi2/cachi2.env; GODEBUG=http2client=0 go mod download; }

COPY --chown=1001:0 osac-observability/ osac-observability/
RUN --mount=type=cache,id=osac-go-pkg,target=/opt/app-root/src/go/pkg,uid=1001,gid=0 \
    --mount=type=cache,id=osac-go-build,target=/opt/app-root/src/.cache/go-build,uid=1001,gid=0 \
    cd osac-observability && { [ -f /cachi2/cachi2.env ] && . /cachi2/cachi2.env; \
    for command in remote-write-config query-allowlist admin-credentials query-auth-gate; do \
    CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -buildvcs=false -o /opt/app-root/src/bin/$command ./cmd/$command || exit 1; \
    done; }

FROM registry.access.redhat.com/ubi10-minimal:10.2-1793642335
ARG VERSION=dev
LABEL name="cloud-extensions/osac-observability-rhel10"
LABEL cpe="cpe:/a:redhat:cloud_extensions:0.1::el10"
LABEL org.opencontainers.image.version="${VERSION}"
WORKDIR /
COPY --from=builder /opt/app-root/src/bin/remote-write-config .
COPY --from=builder /opt/app-root/src/bin/query-allowlist .
COPY --from=builder /opt/app-root/src/bin/admin-credentials .
COPY --from=builder /opt/app-root/src/bin/query-auth-gate .
USER 65532:65532
# Deployments choose their entrypoint with `command`; the remote-write Job is
# the default image consumer.
ENTRYPOINT ["/remote-write-config"]
