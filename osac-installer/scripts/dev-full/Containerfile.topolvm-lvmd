ARG TOPOLVM_VERSION=0.42.1

FROM ghcr.io/topolvm/topolvm:${TOPOLVM_VERSION}@sha256:d6e08d047a56094952b4715830b7b7a71908b083f19f6b374facbe5c3624ec2e AS topolvm

FROM ubuntu:22.04@sha256:5ec03bb3441e8b0bf3b4f9cd4629a1ae763010dc3035bb8da3ae6cf026486401
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install --yes --no-install-recommends lvm2 xfsprogs \
    && mkdir -p /etc/topolvm \
    && rm -rf /var/lib/apt/lists/*
# This helper has no udev daemon. Let LVM create its device nodes and symlinks.
RUN printf 'activation {\n    udev_rules = 0\n    udev_sync = 0\n}\n' > /etc/lvm/lvm.conf
COPY --from=topolvm /hypertopolvm /usr/local/bin/hypertopolvm
RUN ln -s /usr/local/bin/hypertopolvm /usr/local/bin/lvmd
