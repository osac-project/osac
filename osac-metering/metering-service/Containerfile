FROM registry.access.redhat.com/ubi10/go-toolset:10.2-1788946935 AS builder
ARG TARGETOS
ARG TARGETARCH

# Build context is the repo root (not osac-metering/) so the shared top-level
# proto/ module -- resolved via `replace github.com/osac-project/osac/proto
# => ../../proto` in go.mod -- is reachable. metering-service still builds as a
# standalone module (no go.work), with local deps supplied by replace directives.
WORKDIR /opt/app-root/src
COPY --chown=1001:0 proto/ proto/
COPY --chown=1001:0 osac-metering/schema/ osac-metering/schema/
COPY --chown=1001:0 osac-metering/metering-service/go.mod osac-metering/metering-service/go.sum osac-metering/metering-service/
RUN cd osac-metering/metering-service && go mod download

COPY --chown=1001:0 osac-metering/metering-service/ osac-metering/metering-service/

RUN cd osac-metering/metering-service && CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -buildvcs=false -a -o /opt/app-root/src/bin/metering-service ./cmd/metering-service

FROM registry.access.redhat.com/ubi10-minimal:10.2
WORKDIR /
COPY --from=builder /opt/app-root/src/bin/metering-service .
USER 65532:65532
ENTRYPOINT ["/metering-service"]
