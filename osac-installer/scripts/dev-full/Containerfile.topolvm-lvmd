ARG TOPOLVM_VERSION=0.41.1

FROM ghcr.io/topolvm/topolvm:${TOPOLVM_VERSION}@sha256:47a2ffbbef09f014aa4c06a143fffa94c5dbf76647c19d8f9fe30bdb5f7f5634 AS topolvm

FROM ubuntu:26.04@sha256:c098726dd9b9733f3e885f8de0ef375206a311b0a317eadc40d347b1115fb944
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install --yes --no-install-recommends lvm2 xfsprogs \
    && mkdir -p /etc/topolvm \
    && rm -rf /var/lib/apt/lists/*
# This helper has no udev daemon. Let LVM create its device nodes and symlinks.
RUN printf 'activation {\n    udev_rules = 0\n    udev_sync = 0\n}\n' > /etc/lvm/lvm.conf
COPY --from=topolvm /hypertopolvm /usr/local/bin/hypertopolvm
RUN ln -s /usr/local/bin/hypertopolvm /usr/local/bin/lvmd
