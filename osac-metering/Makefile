.PHONY: all clean helm-lint helm-test test lint rules-render-test rules-unchanged-test \
	readers-render-test contract contract-check schemas-unchanged-test

all: test lint

helm-lint:
	helm lint charts/osac-metering/

# Chart render tests. Requires the helm-unittest plugin (CI pins v1.2.1).
helm-test:
	helm unittest charts/osac-metering

test:
	$(MAKE) -C schema test
	$(MAKE) -C metering-service test
	$(MAKE) -C adapters test
	$(MAKE) rules-render-test
	$(MAKE) rules-unchanged-test
	$(MAKE) schemas-unchanged-test
	$(MAKE) readers-render-test

# Granting or revoking a reader must not change the metering Deployment, and a
# removed reader's KafkaUser must disappear; see scripts/test-readers-render.sh.
readers-render-test:
	./scripts/test-readers-render.sh

# The revision ConfigMap is immutable, so its render must not change across
# chart versions; see scripts/test-rules-render.sh.
rules-render-test:
	./scripts/test-rules-render.sh

# A released revision must never be edited; see scripts/test-rules-unchanged.sh.
rules-unchanged-test:
	./scripts/test-rules-unchanged.sh

# A released schema version must never be edited; see
# scripts/test-contract-schemas.sh.
schemas-unchanged-test:
	./scripts/test-contract-schemas.sh

# The contract reference and checkable schema file are generated by a build
# tool; see metering-service/tools/contract.
contract:
	cd metering-service && go run ./cmd/metering-contract

contract-check:
	cd metering-service && go test ./tools/contract
	./scripts/test-service-deps.sh

lint: helm-lint
	$(MAKE) -C schema lint
	$(MAKE) -C metering-service lint
	$(MAKE) -C adapters lint

clean:
	$(MAKE) -C schema clean
	$(MAKE) -C metering-service clean
	$(MAKE) -C adapters clean
