# NOTE: Paths below assume the repo is cloned at ~/work/src/github/osac.
# Edit WorkingDirectory to match your local checkout.

[Unit]
Description=OSAC PR Slack Notifier - post dashboard summary to Slack
After=network.target

[Service]
Type=oneshot
TimeoutStartSec=120
ExecStart=/usr/bin/python3 notify.py --config config.toml
WorkingDirectory=%h/work/src/github/osac/tools/pr-notify
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin

[Install]
WantedBy=default.target
