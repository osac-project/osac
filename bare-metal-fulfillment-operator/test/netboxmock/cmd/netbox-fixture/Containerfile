# Build context is bare-metal-fulfillment-operator/.
FROM registry.access.redhat.com/ubi10/go-toolset:1.26 AS builder
WORKDIR /opt/app-root/src
COPY --chown=1001:0 go.mod .
COPY --chown=1001:0 test/netboxmock/ test/netboxmock/
RUN GOWORK=off CGO_ENABLED=0 go build -o /tmp/netbox-fixture ./test/netboxmock/cmd/netbox-fixture

FROM registry.access.redhat.com/ubi10-minimal:10.2
COPY --from=builder /tmp/netbox-fixture /netbox-fixture
USER 1001:0
ENTRYPOINT ["/netbox-fixture"]
