FROM registry.access.redhat.com/ubi10/go-toolset:1.26 AS builder
WORKDIR /opt/app-root/src
COPY --chown=1001:0 proto/go.mod proto/go.sum proto/
COPY --chown=1001:0 fulfillment-service/go.mod fulfillment-service/go.sum fulfillment-service/
COPY --chown=1001:0 bare-metal-fulfillment-operator/go.mod bare-metal-fulfillment-operator/go.sum bare-metal-fulfillment-operator/
COPY --chown=1001:0 osac-operator/go.mod osac-operator/go.sum osac-operator/
COPY --chown=1001:0 osac-operator/api/go.mod osac-operator/api/go.sum osac-operator/api/
COPY --chown=1001:0 tests/integration/caas/go.mod tests/integration/caas/go.sum tests/integration/caas/go.work tests/integration/caas/
RUN --mount=type=cache,id=osac-go-pkg,target=/opt/app-root/src/go/pkg,uid=1001,gid=0 \
    cd tests/integration/caas && GODEBUG=http2client=0 go mod download

COPY --chown=1001:0 tests/integration/caas/ tests/integration/caas/
WORKDIR /opt/app-root/src/tests/integration/caas
RUN --mount=type=cache,id=osac-go-pkg,target=/opt/app-root/src/go/pkg,uid=1001,gid=0 \
    --mount=type=cache,id=osac-go-build,target=/opt/app-root/src/.cache/go-build,uid=1001,gid=0 \
    CGO_ENABLED=0 go build -trimpath -o simulator ./cmd/simulator

FROM registry.access.redhat.com/ubi10-minimal:10.2
WORKDIR /
COPY --from=builder /opt/app-root/src/tests/integration/caas/simulator /simulator
USER 1001
ENTRYPOINT ["/simulator"]
