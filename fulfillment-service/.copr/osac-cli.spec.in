%global debug_package %{nil}

Name: osac-cli
Version: @version@
Release: 1%{?dist}
Summary: CLI for the Open Sovereign AI Cloud platform
License: ASL 2.0
URL: https://github.com/osac-project/fulfillment-service
Source: %{name}-%{version}.tar.gz

BuildRequires: golang

%description
CLI for the Open Sovereign AI Cloud platform

%prep
%setup

%build
cd fulfillment-service
go build \
-ldflags="-X github.com/osac-project/osac/fulfillment-service/internal/version.id=%{version}" \
./cmd/osac

%install
install -m 0755 -d %{buildroot}%{_bindir}
install -m 0755 fulfillment-service/osac %{buildroot}%{_bindir}

%files
%license LICENSE
%doc fulfillment-service/README.md
%{_bindir}/*

%changelog
* @date@ OSAC <noreply@redhat.com> - @version@
- Automatic build for version @version@.
