FROM registry.access.redhat.com/ubi10/go-toolset:1.26.7-1791275880 AS builder
ARG TARGETOS
ARG TARGETARCH

# Build context is the repo root (not osac-metering/) so the shared top-level
# proto/ module -- resolved via `replace github.com/osac-project/osac/proto
# => ../../proto` in go.mod -- is reachable. metering-service's own go.mod
# still resolves its deps via local replace directives, not workspace
# imports, but go.work is copied in anyway (see below) so hermetic prefetch
# and the real build resolve dependencies the same way.
WORKDIR /opt/app-root/src
# go.work.sum is intentionally not copied in -- it's not committed to the
# repo (see root .gitignore); go mod download below regenerates it inside
# the build using the go.sum files already copied in per module. go.work
# itself IS needed here even though this module doesn't import any workspace
# sibling: Hermeto's hermetic prefetch runs against the full repo checkout
# (not just this Containerfile's COPY set), sees go.work at the repo root
# regardless, and resolves/prefetches dependencies in workspace mode --
# confirmed live (a real Konflux PR build failed with specific packages
# missing from the prefetch cache when this Containerfile omitted go.work,
# because the actual `go mod download` then ran in standalone mode while
# prefetch had resolved workspace-wide). Copying go.work here just makes the
# real build consistent with what was already prefetched; it doesn't change
# which packages this module's own code can import.
COPY --chown=1001:0 go.work ./
COPY --chown=1001:0 proto/go.mod proto/go.sum proto/
COPY --chown=1001:0 osac-operator/go.mod osac-operator/go.sum osac-operator/
COPY --chown=1001:0 osac-operator/api/go.mod osac-operator/api/go.sum osac-operator/api/
COPY --chown=1001:0 bare-metal-fulfillment-operator/go.mod bare-metal-fulfillment-operator/go.sum bare-metal-fulfillment-operator/
COPY --chown=1001:0 fulfillment-service/go.mod fulfillment-service/go.sum fulfillment-service/
COPY --chown=1001:0 osac-csi-driver/go.mod osac-csi-driver/go.sum osac-csi-driver/
COPY --chown=1001:0 osac-metering/adapters/go.mod osac-metering/adapters/go.sum osac-metering/adapters/
COPY --chown=1001:0 osac-ui/proxy/go.mod osac-ui/proxy/go.sum osac-ui/proxy/
COPY --chown=1001:0 osac-metering/schema/go.mod osac-metering/schema/go.sum osac-metering/schema/
COPY --chown=1001:0 osac-metering/metering-service/go.mod osac-metering/metering-service/go.sum osac-metering/metering-service/
# [ -f /cachi2/cachi2.env ] && . ... sources Hermeto/Cachi2's generated env
# (GOPROXY/GOFLAGS pointed at the prefetched module cache) when present --
# i.e. a hermetic Konflux build. Absent entirely for local/non-hermetic
# builds, where go mod download falls back to the real network as before.
# Share module downloads and checksum database state across component builds.
RUN --mount=type=cache,id=osac-go-pkg,target=/opt/app-root/src/go/pkg,uid=1001,gid=0 \
    cd osac-metering/metering-service && { [ -f /cachi2/cachi2.env ] && . /cachi2/cachi2.env; GODEBUG=http2client=0 go mod download; }

COPY --chown=1001:0 proto/ proto/
COPY --chown=1001:0 osac-metering/schema/ osac-metering/schema/
COPY --chown=1001:0 osac-metering/metering-service/ osac-metering/metering-service/

RUN --mount=type=cache,id=osac-go-pkg,target=/opt/app-root/src/go/pkg,uid=1001,gid=0 \
    --mount=type=cache,id=osac-go-build,target=/opt/app-root/src/.cache/go-build,uid=1001,gid=0 \
    cd osac-metering/metering-service && { [ -f /cachi2/cachi2.env ] && . /cachi2/cachi2.env; CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -buildvcs=false -o /opt/app-root/src/bin/metering-service ./cmd/metering-service; }

FROM registry.access.redhat.com/ubi10-minimal:10.2-1790075626
# Stamped to the real release version on osac-build-and-publish.yaml's
# temp branch before tagging (same mechanism as Chart.yaml's own
# version field) -- the committed default below is only ever what a
# local/dev build sees. Surfaced as a real OCI label so Konflux's
# release-side {{ oci_version }} tag templating resolves to it instead
# of silently falling back to the base image's own inherited version
# label.
ARG VERSION=dev
LABEL name="cloud-extensions/metering-service-rhel10"
LABEL cpe="cpe:/a:redhat:cloud_extensions:0.1::el10"
LABEL org.opencontainers.image.version="${VERSION}"
WORKDIR /
COPY --from=builder /opt/app-root/src/bin/metering-service .
USER 65532:65532
ENTRYPOINT ["/metering-service"]
