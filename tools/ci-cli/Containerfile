# Custom OSAC CI CLI image
#
# Extends the OpenShift origin-cli with tools required by OSAC Helm
# hook Jobs: jq, grpcurl, and the osac CLI.  Built for amd64 and
# arm64 so Mac (Apple Silicon) developers can run the same image
# locally.
#
# Build context: mono-repo root (not tools/ci-cli/ alone).
#
#   docker buildx build \
#     --platform linux/amd64,linux/arm64 \
#     -f tools/ci-cli/Containerfile \
#     -t quay.io/osac-project/ci-cli:latest \
#     --push .
#
# See tools/ci-cli/build-push.sh for the full multi-arch workflow.

# ---------------------------------------------------------------------------
# Stage 1 -- build the osac CLI from source
# ---------------------------------------------------------------------------
FROM registry.access.redhat.com/ubi10/go-toolset:1.26.7-1788946935 AS builder

# Copy go.work and all workspace go.mod/go.sum files for dependency caching.
WORKDIR /opt/app-root/src
COPY --chown=1001:1001 go.work ./
COPY --chown=1001:1001 proto/go.mod proto/go.sum proto/
COPY --chown=1001:1001 fulfillment-service/go.mod fulfillment-service/go.sum fulfillment-service/
COPY --chown=1001:1001 bare-metal-fulfillment-operator/go.mod bare-metal-fulfillment-operator/go.sum bare-metal-fulfillment-operator/
COPY --chown=1001:1001 osac-operator/go.mod osac-operator/go.sum osac-operator/
COPY --chown=1001:1001 osac-operator/api/go.mod osac-operator/api/go.sum osac-operator/api/
COPY --chown=1001:1001 osac-csi-driver/go.mod osac-csi-driver/go.sum osac-csi-driver/
COPY --chown=1001:1001 osac-metering/schema/go.mod osac-metering/schema/go.sum osac-metering/schema/
COPY --chown=1001:1001 osac-metering/metering-service/go.mod osac-metering/metering-service/go.sum osac-metering/metering-service/
COPY --chown=1001:1001 osac-metering/adapters/go.mod osac-metering/adapters/go.sum osac-metering/adapters/
RUN cd fulfillment-service && go mod download

ARG VERSION=""

# Copy source for the osac CLI and its workspace dependencies.
COPY --chown=1001:1001 proto/ proto/
COPY --chown=1001:1001 fulfillment-service/ fulfillment-service/
COPY --chown=1001:1001 bare-metal-fulfillment-operator/ bare-metal-fulfillment-operator/
COPY --chown=1001:1001 osac-operator/api/ osac-operator/api/

WORKDIR /opt/app-root/src/fulfillment-service
RUN \
  set -e; \
  version="${VERSION}"; \
  if [[ -z "${version}" ]]; then \
    version=$(git describe --tags --always 2>/dev/null || echo "dev"); \
  fi; \
  ldflags="-X github.com/osac-project/osac/fulfillment-service/internal/version.id=${version}"; \
  CGO_ENABLED=0 go build -ldflags="${ldflags}" -o /tmp/osac ./cmd/osac

# ---------------------------------------------------------------------------
# Stage 2 -- assemble the final image
# ---------------------------------------------------------------------------
FROM quay.io/openshift/origin-cli:4.20.0

ARG TARGETARCH
ARG GRPCURL_VERSION=1.9.1

USER 0

# Install jq (available in UBI repos).
RUN dnf install -y --nodocs --setopt=install_weak_deps=0 jq && \
    dnf clean all && \
    rm -rf /var/cache/dnf

# Install grpcurl (pre-built for the target architecture).
RUN curl -fsSL \
      "https://github.com/fullstorydev/grpcurl/releases/download/v${GRPCURL_VERSION}/grpcurl_${GRPCURL_VERSION}_linux_${TARGETARCH}.tar.gz" \
    | tar -xz -C /usr/local/bin grpcurl && \
    chmod +x /usr/local/bin/grpcurl

# Install the osac CLI built in stage 1.
COPY --from=builder /tmp/osac /usr/local/bin/osac

# Drop back to non-root.
USER 1001

# Smoke-test all added tools.
RUN jq --version && grpcurl --version && osac --help > /dev/null

ENTRYPOINT ["/bin/bash"]
