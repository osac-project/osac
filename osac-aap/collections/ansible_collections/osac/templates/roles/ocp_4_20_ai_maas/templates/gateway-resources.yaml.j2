apiVersion: v1
kind: ConfigMap
metadata:
  name: "{{ _gw_name }}-options"
  namespace: openshift-ingress
data:
  # Istio Gateway-infrastructure schema: a top-level `deployment` key holding a
  # strategic-merge overlay of the istio-proxy container. The single-tenant /
  # default gateway is the sole enforcer and OOMKills at 1Gi — needs 2Gi.
  deployment: |
    spec:
      template:
        spec:
          containers:
          - name: istio-proxy
            resources:
              requests:
                memory: 512Mi
              limits:
                memory: "{{ ocp_4_20_ai_maas_gateway_memory_limit }}"
