# AI workflows and skills (installed by tools/bootstrap.sh)
skills/
.ai-workflows/
# Interactive clone populated by tools/bootstrap.sh. A later pin may occupy
# this path and drop the ignore.
.osac-ai-skills/

# Skill-relative sibling checkouts (tools/bootstrap.sh). osac-docs is
# osac-project/docs — do not ignore docs/ (in-tree ARCHITECTURE/CONVENTIONS).
# osac-test-infra/ is kept so leftover clones from older bootstrap runs
# are not committed; bootstrap no longer creates it (E2E is tests/e2e/).
enhancement-proposals/
osac-ux/
osac-ui/
osac-test-infra/
osac-docs/

# Local GitHub fork-name mappings (see tools/fork-overrides.sh.example).
/tools/fork-overrides.sh

# Harness output and osac-ai-skills fan-out. Keep repo-local Claude settings
# and hook *scripts* tracked; fan-out only adds .claude/hooks/README.md.
.claude/*
!.claude/hooks/
!.claude/settings.json
.claude/hooks/README.md
.cursor/
.gemini/

# Shared design/prd guidance (fan-out). No repo-local files in these trees —
# ignore the directories so new shared names do not require a gitignore bump.
.design/
.prd/

# graphify knowledge-graph output -- fetched from the published CI bundle
# (see .github/workflows/graphify-brain-refresh.yaml), never committed.
graphify-out/

# Shared tool binaries (tools/golangci-lint.mk), downloaded once for all components
/tools/bin/

