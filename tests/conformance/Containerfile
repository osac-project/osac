# Build context: the osac repository root.
#   podman build -f tests/conformance/Containerfile -t osac-conformance:dev .
FROM registry.k8s.io/kubectl:v1.32.1 AS kubectl

FROM registry.access.redhat.com/ubi9/python-312:latest

# The suite runs as UID 0 by design: it runs with --userns=host so it can open
# the runner's podman socket. See "Running the suite" in the conformance design.
USER 0

WORKDIR /opt/osac

COPY --from=kubectl /kubectl /usr/local/bin/kubectl
COPY pyproject.toml uv.lock ./
COPY tests ./tests
RUN python3 -m pip install --no-cache-dir .

ENTRYPOINT ["osac-conformance"]
