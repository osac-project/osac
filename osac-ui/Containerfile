# Multi-stage build: one image runs the Go proxy + serves the SPA bundle
# Usage:
#   podman build -t osac:latest -f Containerfile .
#   podman run --rm -p 8080:8080 -e FULFILLMENT_API_URL=https://fulfillment.example.com osac:latest

# ── Stage 1: install SPA workspace dependencies ───────────────────────────
FROM registry.access.redhat.com/ubi9/nodejs-22-minimal:9.8-1791835973 AS deps
USER root
WORKDIR /app

# Install pnpm itself offline from Hermeto/Cachi2's prefetched tarball
# (see artifacts.lock.yaml) when present -- i.e. a hermetic Konflux build,
# where `npm install -g pnpm@<version>` would otherwise need live network
# access to the npm registry just to install the package manager before any
# project dependency can be resolved. Falls back to the live registry
# install, pinned to the same exact version, for local/non-hermetic builds.
RUN if [ -f /cachi2/output/deps/generic/pnpm-9.15.9.tgz ]; then \
      npm install -g /cachi2/output/deps/generic/pnpm-9.15.9.tgz; \
    else \
      npm install -g pnpm@9.15.9; \
    fi

# .npmrc* (optional -- none committed to the repo) picks up Hermeto's
# injected registry override (a local file:// path redirect) during a
# hermetic build. Without it, `pnpm install` has no override for any
# package not already in its local store, and falls back to the live
# registry -- confirmed live via a real Konflux PR build failure where
# most packages fetched fine via the artifact-registry-proxy, but a
# cluster of specific packages failed with ENOTFOUND against
# registry.npmjs.org directly.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* .npmrc* tsconfig.base.json ./
COPY libs/i18n/package.json ./libs/i18n/
COPY libs/types/package.json ./libs/types/
COPY libs/ui-components/package.json ./libs/ui-components/
COPY apps/app-frontend/package.json ./apps/app-frontend/

# [ -f /cachi2/cachi2.env ] && . ... sources Hermeto/Cachi2's generated env
# (pointed at the prefetched pnpm store) when present -- i.e. a hermetic
# Konflux build. Absent entirely for local/non-hermetic builds, where pnpm
# installs from the real registry as before.
RUN [ -f /cachi2/cachi2.env ] && . /cachi2/cachi2.env; pnpm install --frozen-lockfile

# ── Stage 2: build SPA ────────────────────────────────────────────────────
FROM deps AS spa-builder
WORKDIR /app

COPY libs/ ./libs/
COPY apps/app-frontend/ ./apps/app-frontend/

# SPA output goes to apps/app-frontend/dist (configured in vite.config.ts outDir)
RUN [ -f /cachi2/cachi2.env ] && . /cachi2/cachi2.env; pnpm --filter @osac/app-frontend run build

# ── Stage 3: build Go proxy ───────────────────────────────────────────────
FROM registry.access.redhat.com/ubi9/go-toolset:1.26 AS proxy-builder
USER root
WORKDIR /build

COPY proxy/go.mod proxy/go.sum ./
# [ -f /cachi2/cachi2.env ] && . ... sources Hermeto/Cachi2's generated env
# (GOPROXY/GOFLAGS pointed at the prefetched module cache) when present --
# i.e. a hermetic Konflux build. Absent entirely for local/non-hermetic
# builds, where go mod download falls back to the real network as before.
# proxy/ is not a go.work member as far as this build or Hermeto's prefetch
# are concerned: the clone-repository task's sparseCheckoutDirectories
# param (see *-pull-request/push/release.yaml) limits the checkout fed to
# both prefetch and this build to osac-ui/ only, so go.work genuinely
# doesn't exist anywhere in either one's view of the source tree -- no
# workspace-vs-standalone resolution mismatch to reconcile, confirmed live.
RUN [ -f /cachi2/cachi2.env ] && . /cachi2/cachi2.env; go mod download

COPY proxy/ ./
RUN [ -f /cachi2/cachi2.env ] && . /cachi2/cachi2.env; CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o osac-proxy .

# ── Stage 4: production image ──────────────────────────────────────────────
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8 AS production
LABEL name="cloud-extensions/osac-ui-rhel10"
LABEL cpe="cpe:/a:redhat:cloud_extensions:0.1::el10"
WORKDIR /app

ENV PORT=8080
ENV HOST=0.0.0.0
ENV LOG_LEVEL=info

# Copy the compiled Go binary
COPY --from=proxy-builder /build/osac-proxy ./osac-proxy

# Copy the built SPA (vite outDir = apps/app-frontend/dist)
COPY --from=spa-builder /app/apps/app-frontend/dist ./public

EXPOSE 8080
USER 1001

CMD ["./osac-proxy"]
