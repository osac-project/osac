#!/usr/bin/bash
set -u

tenant_device=""
tenant_source=""
tenant_priority=-1
tenant_metric=2147483647
for attempt in $(seq 1 180); do
  while read -r route; do
    device="$(printf '%s\n' "$route" | awk '{for (i=1; i<=NF; i++) if ($i == "dev") {print $(i+1); exit}}')"
    source="$(printf '%s\n' "$route" | awk '{for (i=1; i<=NF; i++) if ($i == "src") {print $(i+1); exit}}')"
    metric_value="$(printf '%s\n' "$route" | awk '{for (i=1; i<=NF; i++) if ($i == "metric") {print $(i+1); exit}}')"
    [ -n "$device" ] || continue
    case "$device" in br-*|ovs-*|ovn-*|cni*|lo) continue ;; esac
    case "$metric_value" in ''|*[!0-9]*) metric_value=0 ;; esac
    connection="$(nmcli -g GENERAL.CONNECTION device show "$device" 2>/dev/null | head -n1)"
    method=""
    if [ -n "$connection" ]; then
      method="$(nmcli -g ipv4.method connection show "$connection" 2>/dev/null | head -n1)"
    fi
    priority=1
    [ "$method" = "auto" ] && priority=2
    if [ "$priority" -gt "$tenant_priority" ] || {
      [ "$priority" -eq "$tenant_priority" ] &&
      [ "$metric_value" -lt "$tenant_metric" ]
    }; then
      tenant_device="$device"
      tenant_source="$source"
      tenant_priority="$priority"
      tenant_metric="$metric_value"
    fi
  done < <(ip -4 route show default)
  [ -n "$tenant_device" ] && break
  tenant_device=""
  tenant_source=""
  tenant_priority=-1
  tenant_metric=2147483647
  sleep 1
done

[ -n "$tenant_device" ] || exit 1
for device in $(nmcli -t -f DEVICE,TYPE device status | awk -F: '$2 == "ethernet" {print $1}'); do
  connection="$(nmcli -g GENERAL.CONNECTION device show "$device" | head -n1)"
  [ -n "$connection" ] || continue
  if [ "$device" = "$tenant_device" ]; then
    nmcli connection modify "$connection" ipv4.never-default no ipv4.route-metric 10
  else
    nmcli connection modify "$connection" ipv4.never-default yes ipv4.route-metric 100
  fi
  nmcli connection up "$connection" || true
done
