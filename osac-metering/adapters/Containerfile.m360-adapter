FROM registry.access.redhat.com/ubi10/go-toolset:1.26.7-1791275880 AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /opt/app-root/src
COPY --chown=1001:0 schema/ schema/
COPY --chown=1001:0 shared/ shared/
COPY --chown=1001:0 adapters/go.mod adapters/go.sum adapters/
# [ -f /cachi2/cachi2.env ] && . ... sources Hermeto/Cachi2's generated env
# (GOPROXY/GOFLAGS pointed at the prefetched module cache) when present --
# i.e. a hermetic Konflux build. Absent entirely for local/non-hermetic
# builds, where go mod download falls back to the real network as before.
RUN cd adapters && { [ -f /cachi2/cachi2.env ] && . /cachi2/cachi2.env; go mod download; }

COPY --chown=1001:0 adapters/ adapters/

RUN cd adapters && { [ -f /cachi2/cachi2.env ] && . /cachi2/cachi2.env; CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -buildvcs=false -a -o /opt/app-root/src/m360-adapter ./cmd/m360-adapter; }

FROM registry.access.redhat.com/ubi10-minimal:10.2-1790075626
LABEL name="cloud-extensions/metering-m360-adapter-rhel10"
LABEL cpe="cpe:/a:redhat:cloud_extensions:0.1::el10"
WORKDIR /
COPY --from=builder /opt/app-root/src/m360-adapter .
USER 65532:65532
ENTRYPOINT ["/m360-adapter"]
